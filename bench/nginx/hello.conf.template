# Generated by bench/compare-run.py. workers and the pid path are
# filled in per run. The body is `return 200`, not a file:
# nginx's static module answers POST with 405. sendfile is on but
# does not apply to `return`. keepalive_requests is high so a
# keep-alive run does not reconnect after the default 1000.
# reuseport matches muro-http's Linux SO_REUSEPORT workers.
# backlog 4096 matches SOMAXCONN / net.core.somaxconn.

worker_processes WORKERS;
worker_rlimit_nofile 65536;
error_log stderr error;
pid PID_PATH;
daemon off;

events {
    worker_connections 8192;
    multi_accept off;
    use epoll;
}

http {
    access_log off;
    sendfile on;
    tcp_nopush off;
    tcp_nodelay on;
    keepalive_timeout 60s;
    keepalive_requests 10000000;
    default_type text/plain;
    server_tokens on;

    server {
        listen 127.0.0.1:18181 backlog=4096 reuseport;
        server_name _;
        location = / {
            default_type text/plain;
            return 200 "hello\n";
        }
    }
}
