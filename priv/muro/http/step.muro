def cap-hdr-done : evidence {step0 (take sawCapHdr) factWrote capHdr maxBig (toU64 5) (toU64 5) ≡ quiet (toU64 431) : Out} := refl

-- A peer close during a short handler write keeps the stored
-- remainder and forces keep. The finishing write then closes.
-- owed 8 is the span the caller named, the same shape as reply-short.
def shortTwo : run Out :=
  step0 (take sawTwo) factWrote twoGet max10 (toU64 1) (toU64 8)

def peer-short : evidence {step0 (take shortTwo) factPeer twoGet max10 (toU64 0) (toU64 0) ≡ still (toU64 3) (toU64 0) (toU64 7) (toU64 1) : Out} := refl

def peer-short-drops : evidence {step0 (take (step0 (take shortTwo) factPeer twoGet max10 (toU64 0) (toU64 0))) factWrote twoGet max10 (toU64 7) (toU64 0) ≡ quiet (toU64 0) : Out} := refl

-- Bytes appended onto the unconsumed leftover are the whole slice.
def leftoverSt : run St :=
  take (step0 (take sawPipe) factWrote pipePart max10 (toU64 4) (toU64 4))

def leftover-bytes : evidence {step0 leftoverSt factBytes getBuf max10 (toU64 0) (toU64 0) ≡ reply (toU64 0) : Out} := refl

def leftoverWake : run Out :=
  stepFact (take sawPipe) factWrote pipePart max10 (toU64 4) (toU64 4) (toU64 1000) (toU64 0) (toU64 60000)

def leftover-wake : evidence {leftoverWake ≡ moreAt (toU64 1000) (toU64 0) (toU64 60000) : Out} := refl

def leftoverKeep : run Out :=
  stepFact (take sawPipe) factWrote pipePart max10 (toU64 4) (toU64 4) (toU64 1000) (toU64 424242) (toU64 60000)

def leftover-wake-keeps : evidence {wakeOf leftoverKeep ≡ toU64 424242 : U64} := refl

def idle-peer-partial : evidence {step0 idleSt factPeer lineBuf max10 (toU64 0) (toU64 0) ≡ owe (toU64 400) : Out} := refl

def closedClose : run St :=
  take (step0 (take sawClose) factWrote closeBuf max10 (toU64 8) (toU64 8))

def after-close-failed : evidence {step0 closedClose factFailed closeBuf max10 (toU64 0) (toU64 0) ≡ quiet (toU64 0) : Out} := refl

def after-close-accept : evidence {step0 closedClose factAccepted b"" max10 (toU64 0) (toU64 0) ≡ quiet (toU64 0) : Out} := refl

def idle-accept-outside : evidence {coverOf (step0 idleSt factAccepted b"" max10 (toU64 0) (toU64 0)) ≡ toU64 1 : U64} := refl

-- headersDone, and the header block ends past 16384. The request
-- line fits, so capCode is 431. capHdr is the other arm: the header
-- block is not closed, and the slice itself is past 16384.
def capHdrDone : run Slice :=
  b"GET / HTTP/1.1\r\nHost: h\r\nX-Pad: \r\n\r\n"

def sawHdrDone : run Out :=
  step0 readSt factBytes capHdrDone maxBig (toU64 0) (toU64 0)

def headers-done-431 : evidence {headersDone capHdrDone ≡ true : Bool} := refl

def headers-end-431 : evidence {gt16384 (headerEnd capHdrDone) ≡ true : Bool} := refl

def cap-hdr-done-431 : evidence {sawHdrDone ≡ owe (toU64 431) : Out} := refl

def hand-agree : evidence {hand (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 1) (toU64 0) (toU64 1) ≡ reply (toU64 0) : Out} := refl

def hand-close : evidence {hand (toU64 0) (toU64 1) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 1) (toU64 0) (toU64 1) ≡ reply (toU64 1) : Out} := refl

def hand-bad : evidence {hand (toU64 0) (toU64 0) (toU64 1) (toU64 0) (toU64 0) (toU64 0) (toU64 1) (toU64 0) (toU64 1) ≡ reply (toU64 1) : Out} := refl

def hand-keep : evidence {hand (toU64 1) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 1) (toU64 0) (toU64 1) ≡ reply (toU64 1) : Out} := refl

def hand-500 : evidence {hand (toU64 0) (toU64 0) (toU64 0) (toU64 1) (toU64 1) (toU64 0) (toU64 1) (toU64 0) (toU64 1) ≡ shutHandle (toU64 500) : Out} := refl

def hand-refuse : evidence {hand (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 1) (toU64 0) (toU64 1) (toU64 0) (toU64 1) ≡ shutHandle (toU64 0) : Out} := refl

def hand-pull-len : evidence {hand (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 1) (toU64 1) (toU64 0) (toU64 1) ≡ spanPull (toU64 0) (toU64 3) : Out} := refl

def hand-pull-len-bad : evidence {hand (toU64 0) (toU64 0) (toU64 1) (toU64 0) (toU64 0) (toU64 1) (toU64 1) (toU64 0) (toU64 1) ≡ spanPull (toU64 1) (toU64 3) : Out} := refl

def hand-pull-chunk : evidence {hand (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 2) (toU64 1) (toU64 0) (toU64 1) ≡ spanPull (toU64 0) (toU64 4) : Out} := refl

def hand-pull-chunk-close : evidence {hand (toU64 0) (toU64 1) (toU64 0) (toU64 0) (toU64 0) (toU64 2) (toU64 1) (toU64 0) (toU64 1) ≡ spanPull (toU64 1) (toU64 4) : Out} := refl

def hand-pull-delim : evidence {hand (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 2) (toU64 0) (toU64 0) (toU64 1) ≡ spanPull (toU64 1) (toU64 5) : Out} := refl

def hand-pull-head : evidence {hand (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 2) (toU64 1) (toU64 1) (toU64 1) ≡ spanPull (toU64 1) (toU64 5) : Out} := refl

def hand-toobig : evidence {hand (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 1) (toU64 0) (toU64 0) ≡ shutHandle (toU64 0) : Out} := refl

def hand-toobig-owe : evidence {hand (toU64 0) (toU64 0) (toU64 0) (toU64 1) (toU64 0) (toU64 0) (toU64 1) (toU64 0) (toU64 0) ≡ oweFit : Out} := refl

def hand-500-cover : evidence {coverOf (hand (toU64 0) (toU64 0) (toU64 0) (toU64 1) (toU64 1) (toU64 0) (toU64 1) (toU64 0) (toU64 1)) ≡ toU64 0 : U64} := refl

def hand-pull-cover : evidence {coverOf (hand (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 1) (toU64 1) (toU64 0) (toU64 1)) ≡ toU64 0 : U64} := refl

def hand-500-later : evidence {step0 (take (shutHandle (toU64 500))) factBytes getBuf max10 (toU64 0) (toU64 0) ≡ quiet (toU64 500) : Out} := refl
