-- Write slice of one HTTP/1.1 connection.
--
-- c/step.c is still the step the production host calls. This book
-- decides one read, the protocol write, the handler write, and the
-- idle tick. It does not call the kernel or the clock. It does not
-- render bytes. The handler, the admit wall, and host_copy_response
-- stay in C. c/step_book.c owns the buffers and calls this step.
-- It is not linked into the production host. `--backend c` emits
-- c/generated/step_slice.c with c_prefix http_step_.
-- c/test_step_slice feeds the same fact and the same buffer to
-- http_step_stepFact and to muro_http_step, and compares that host
-- with the adapter on the covered paths.
--
-- Fact numbers are c/step.h: 1 accepted, 2 bytes, 3 peer closed,
-- 4 wrote, 5 write failed, 6 now. `n` is the wrote count. `owed`
-- is the outstanding span when `left` is 0. A short write stores
-- `left = owed - n`, and the next wrote uses that stored remainder,
-- so a stale `owed` does not move the span. `n` greater than or
-- equal to that base finishes the span. The host clamps the same
-- way. now, deadline, and idle are the adapter clock. idle is the
-- connection's idle budget in milliseconds.
--
-- Book phase 0 is reading. Book phase 1 owes a protocol span and
-- closes when that span finishes: 400, 413, 414, 417, 431, 501. A
-- request line with no LF in the first 16384 bytes is 414. A header
-- block past 16384 whose request line fit is 431. Book phase 3 owes
-- the handler span for a finished request the policy accepts. keep 0
-- returns to book phase 4 (idle) when that span finishes, and bytes
-- past the request are classified in that same step. A leftover that
-- is still a partial request reads again. keep 1 closes instead:
-- Connection: close, HTTP/1.0, or a peer close during the write
-- (that peer close drops a pipelined tail). Book phase 2 has closed.
-- A closed step ignores every later fact and disarms the deadline.
-- These numbers are book phases, not image phases. Image phases are
-- read 0, handle 1, write 2, idle 3, closed 4.
--
-- span 0 is nothing, 1 is the close status (status_now), 2 is a
-- write span. wake 0 is disarmed. Accept arms now+idle and ignores
-- a carried deadline. A read or an idle step keeps a carried
-- deadline, and arms now+idle when the deadline is 0. A write
-- parks with wake 0. NOW from read or from idle closes. The book
-- does not compare now with the deadline: the fact is the tick,
-- and the two clocks produce the same close. NOW during a write
-- parks that same span again.
--
-- cover 1 is outside this slice: chunked, 100 Continue, a streamed
-- body whose Content-Length is within max while the peer is still
-- open (the host pulls it), accept during a write, and accept while
-- idle. Bytes during a write park the same span. A wrote or a
-- failure while reading stays on the read. The same facts while
-- idle stay idle. The host holds those facts the same way. A
-- finished buffered request on a peer close is a handler span
-- with keep 1. The completing write closes. A within-max streamed
-- body on a peer close is that same handler span
-- (stream-peer-reply, stream-peer-done). A streamed body past max
-- is an owed 413 span. Classify already finished, so that close is
-- the write, not status_now. A wrote with left 0 and owed 0
-- finishes: the caller named an empty span. That finish is in the
-- book (owe-empty-span, reply-empty-span). The host has no such
-- input. It finishes from its own byte counter.
-- The adapter runs the handler, then feeds the result to `hand`.
-- reqKeep is the keep the request already decided. hclose is
-- close_after (the adapter also sets it when an open request body
-- is not owned by the response pull). hbad is 1 for a status
-- 400..599. howe is owe_status. href is 1 when the handler
-- returned -1. hpull is 0 for a buffered body, 1 for a pull with
-- a content length, and 2 for a pull with no length. hver is 1
-- for HTTP/1.1. hhead is 1 for HEAD. hfit is 1 when a buffered
-- body fits; a pull ignores it. A refused handler with owe_status
-- is book phase 5: close now, no span, code 500. The image stays
-- in handle. A buffered body that does not fit is the same shut
-- when owe_status is clear, and a 500 write with keep 1 when it
-- is set. A pull is a handler span whose span field is 3
-- (content-length), 4 (chunked), or 5 (close-delimited). HEAD or
-- a version other than HTTP/1.1 forces the delimited span and
-- keep 1. cover stays 0 on all of these. A later fact on phase 5
-- is quiet, the same as a close.
-- Not claimed here: fuel, the 100 Continue span, and the host's
-- deadline decision (c/host.c on_tick compares the clocks).
-- The C adapter admits each fact with proto_admit. This book does
-- not. A refused admit is note 1 in that adapter.
-- Versus origin/main: 17 evidence names added, none removed, net
-- +17, 143 total. Each one is an equation mix muro.check reduces.
import "request.muro"

unboxed data St : Type where
  st : Π (+ phase : U64) → Π (+ code : U64) → Π (+ left : U64) → Π (+ keep : U64) → St

unboxed data Out : Type where
  out : Π (+ phase : U64) → Π (+ code : U64) → Π (+ close : U64) → Π (+ statusNow : U64) → Π (+ readMore : U64) → Π (+ writeMore : U64) → Π (+ span : U64) → Π (+ cover : U64) → Π (+ left : U64) → Π (+ wake : U64) → Π (+ keep : U64) → Out

def factAccepted : run U64 :=
  toU64 1

def factBytes : run U64 :=
  toU64 2

def factPeer : run U64 :=
  toU64 3

def factWrote : run U64 :=
  toU64 4

def factFailed : run U64 :=
  toU64 5

def factNow : run U64 :=
  toU64 6

def readSt : run St :=
  st (toU64 0) (toU64 0) (toU64 0) (toU64 0)

def arm : run Π (+ now : U64) → Π (+ dl : U64) → Π (+ idle : U64) → U64 :=
  λ (+ now : U64) → λ (+ dl : U64) → λ (+ idle : U64) →
    match (u64eq dl (toU64 0)) motive (λ _ → U64)
      | true => addi now idle
      | false => dl

def moreAt : run Π (+ now : U64) → Π (+ dl : U64) → Π (+ idle : U64) → Out :=
  λ (+ now : U64) → λ (+ dl : U64) → λ (+ idle : U64) →
    out (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 1) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (arm now dl idle) (toU64 0)

def more : run Out :=
  moreAt (toU64 0) (toU64 0) (toU64 0)

def idleAt : run Π (+ now : U64) → Π (+ dl : U64) → Π (+ idle : U64) → Out :=
  λ (+ now : U64) → λ (+ dl : U64) → λ (+ idle : U64) →
    out (toU64 4) (toU64 0) (toU64 0) (toU64 0) (toU64 1) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (arm now dl idle) (toU64 0)

def idle : run Out :=
  idleAt (toU64 0) (toU64 0) (toU64 0)

def outside : run Out :=
  out (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 1) (toU64 0) (toU64 0) (toU64 0)

def quiet : run Π (+ code : U64) → Out :=
  λ (+ code : U64) →
    out (toU64 2) code (toU64 1) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0)

def statusNow : run Π (+ code : U64) → Out :=
  λ (+ code : U64) →
    out (toU64 2) code (toU64 1) (toU64 1) (toU64 0) (toU64 0) (toU64 1) (toU64 0) (toU64 0) (toU64 0) (toU64 0)

def still : run Π (+ phase : U64) → Π (+ code : U64) → Π (+ left : U64) → Π (+ keep : U64) → Out :=
  λ (+ phase : U64) → λ (+ code : U64) → λ (+ left : U64) → λ (+ keep : U64) →
    out phase code (toU64 0) (toU64 0) (toU64 0) (toU64 1) (toU64 2) (toU64 0) left (toU64 0) keep

def owe : run Π (+ code : U64) → Out :=
  λ (+ code : U64) →
    still (toU64 1) code (toU64 0) (toU64 1)

def reply : run Π (+ keep : U64) → Out :=
  λ (+ keep : U64) →
    still (toU64 3) (toU64 0) (toU64 0) keep

def take : run Π (+ o : Out) → St :=
  λ (+ o : Out) →
    match o motive (λ _ → St)
      | out phase code _close _statusNow _readMore _writeMore _span _cover left _wake keep =>
          st phase code left keep

def spanOf : run Π (+ o : Out) → U64 :=
  λ (+ o : Out) →
    match o motive (λ _ → U64)
      | out _phase _code _close _statusNow _readMore _writeMore span _cover _left _wake _keep => span

def coverOf : run Π (+ o : Out) → U64 :=
  λ (+ o : Out) →
    match o motive (λ _ → U64)
      | out _phase _code _close _statusNow _readMore _writeMore _span cover _left _wake _keep => cover

def leftOf : run Π (+ o : Out) → U64 :=
  λ (+ o : Out) →
    match o motive (λ _ → U64)
      | out _phase _code _close _statusNow _readMore _writeMore _span _cover left _wake _keep => left

def wakeOf : run Π (+ o : Out) → U64 :=
  λ (+ o : Out) →
    match o motive (λ _ → U64)
      | out _phase _code _close _statusNow _readMore _writeMore _span _cover _left wake _keep => wake

def keepOut : run Π (+ o : Out) → U64 :=
  λ (+ o : Out) →
    match o motive (λ _ → U64)
      | out _phase _code _close _statusNow _readMore _writeMore _span _cover _left _wake keep => keep

def chunked : run Π (+ s : Slice) → Bool :=
  λ (+ s : Slice) → u64eq (teCode s) (toU64 1)

def methodUnimpl : run Π (+ s : Slice) → Bool :=
  λ (+ s : Slice) → u64eq (methodCode s) (toU64 1)

def tooLong : run Π (+ s : Slice) → Π (+ max : U64) → Bool :=
  λ (+ s : Slice) → λ (+ max : U64) →
    match (sawCL s) motive (λ _ → Bool)
      | true => u64lt max (contentLength s)
      | false => false

def ver11 : run Π (+ s : Slice) → Bool :=
  λ (+ s : Slice) → spanEq (versionView s) b"HTTP/1.1"

def expectIs : run Π (+ s : Slice) → Π (+ n : U64) → Bool :=
  λ (+ s : Slice) → λ (+ n : U64) → u64eq (expectCode s) n

-- A body the host will stream: headers are done, the buffered body
-- is short, and Content-Length is past 16384. That pull is not this
-- slice. A complete body is not short, so it is not streamed.
def streamed : run Π (+ s : Slice) → Bool :=
  λ (+ s : Slice) → and (bodyShort s) (gt16384 (contentLength s))

-- Chunked is outside this slice, before the status order, so a
-- chunked TRACE is not claimed as 501. The rest matches
-- host_in_policy: method code 1 is 501, then Content-Length over
-- max is 413, then an HTTP/1.1 Expect other than 100-continue is
-- 417, then 100-continue with a short body is outside.
-- 9 is outside the slice. 0 is no policy status.
def policy : run Π (+ s : Slice) → Π (+ max : U64) → U64 :=
  λ (+ s : Slice) → λ (+ max : U64) →
    match (chunked s) motive (λ _ → U64)
      | true => toU64 9
      | false =>
          (match (methodUnimpl s) motive (λ _ → U64)
            | true => toU64 501
            | false =>
                (match (tooLong s max) motive (λ _ → U64)
                  | true => toU64 413
                  | false =>
                      (match (and (ver11 s) (expectIs s (toU64 2))) motive (λ _ → U64)
                        | true => toU64 417
                        | false =>
                            (match (and (ver11 s) (and (expectIs s (toU64 1)) (bodyShort s))) motive (λ _ → U64)
                              | true => toU64 9
                              | false => toU64 0))))

def isPol : run Π (+ n : U64) → Π (+ c : U64) → Bool :=
  λ (+ n : U64) → λ (+ c : U64) → u64eq n c

-- 1 when the first 16384 bytes hold no LF. limit_which in c/step.c
-- returns 414 for that line and 431 once a line fits.
def capLfStep : run Π (b : U8) → Π (+ acc : U64) → U64 :=
  λ (b : U8) → λ (+ acc : U64) →
    match (u64eq acc (toU64 0)) motive (λ _ → U64)
      | true =>
          (match (u8eq b (toU8 10)) motive (λ _ → U64)
            | true => toU64 1
            | false => toU64 0)
      | false => acc

def capHit : run Π (+ s : Slice) → U64 :=
  λ (+ s : Slice) →
    sliceFold U64 (toU64 0)
      (λ (b : U8) → λ (_r : Slice) → λ (acc : U64) → capLfStep b acc)
      (slice s (toU64 0) (toU64 16384))

def capCode : run Π (+ s : Slice) → U64 :=
  λ (+ s : Slice) →
    match (u64eq (capHit s) (toU64 0)) motive (λ _ → U64)
      | true => toU64 414
      | false => toU64 431

def replyKeep : run Π (k : Keep) → Out :=
  λ (k : Keep) →
    match k motive (λ _ → Out)
      | keep-yes => reply (toU64 0)
      | keep-no => reply (toU64 1)

-- reading 1: classify still wants bytes, so a policy status is
-- status_now and the step closes. reading 0: classify finished, so
-- the handwritten step answers through the write span. code 0 only
-- arrives with reading 1. A finished request (reading 0, code 0) is
-- replyKeep, before this call, so there is no reply arm here.
def usePol : run Π (+ code : U64) → Π (+ reading : U64) → Π (+ now : U64) → Π (+ dl : U64) → Π (+ idle : U64) → Out :=
  λ (+ code : U64) → λ (+ reading : U64) → λ (+ now : U64) → λ (+ dl : U64) → λ (+ idle : U64) →
    match (isPol code (toU64 9)) motive (λ _ → Out)
      | true => outside
      | false =>
          (match (isPol code (toU64 0)) motive (λ _ → Out)
            | true => moreAt now dl idle
            | false =>
                (match (u64eq reading (toU64 1)) motive (λ _ → Out)
                  | true => statusNow code
                  | false => owe code))

-- A finished request on a peer close is the handler span with
-- keep 1. The completing write closes and drops a pipelined tail.
-- Policy 9 (chunked, or 100-continue) stays outside. A policy
-- status is an owed span.
def finOk : run Π (+ code : U64) → Out :=
  λ (+ code : U64) →
    match (isPol code (toU64 0)) motive (λ _ → Out)
      | true => reply (toU64 1)
      | false =>
          (match (isPol code (toU64 9)) motive (λ _ → Out)
            | true => outside
            | false => owe code)

def onStatus : run Π (+ st : Status) → Π (+ fin : U64) → Π (+ s : Slice) → Π (+ max : U64) → Π (+ now : U64) → Π (+ dl : U64) → Π (+ idle : U64) → Out :=
  λ (+ st : Status) → λ (+ fin : U64) → λ (+ s : Slice) → λ (+ max : U64) → λ (+ now : U64) → λ (+ dl : U64) → λ (+ idle : U64) →
    match st motive (λ _ → Out)
      | status-ok =>
          (match (u64eq fin (toU64 1)) motive (λ _ → Out)
            | true => finOk (policy s max)
            | false =>
                (match (isPol (policy s max) (toU64 0)) motive (λ _ → Out)
                  | true =>
                      (match (streamed s) motive (λ _ → Out)
                        | true => outside
                        | false => replyKeep (keepOf s))
                  | false => usePol (policy s max) (toU64 0) now dl idle))
      | status-malformed =>
          (match (headersDone s) motive (λ _ → Out)
            | true =>
                (match (gt16384 (headerEnd s)) motive (λ _ → Out)
                  | true => owe (capCode s)
                  | false => owe (toU64 400))
            | false =>
                (match (gt16384 (sliceLen s)) motive (λ _ → Out)
                  | true => owe (capCode s)
                  | false => owe (toU64 400)))
      | status-need-more =>
          (match (u64eq fin (toU64 1)) motive (λ _ → Out)
            | true => owe (toU64 400)
            | false =>
                (match (headersDone s) motive (λ _ → Out)
                  | true => usePol (policy s max) (toU64 1) now dl idle
                  | false => moreAt now dl idle))
      | status-unimplemented => owe (toU64 501)

def onBuf : run Π (+ fin : U64) → Π (+ s : Slice) → Π (+ max : U64) → Π (+ now : U64) → Π (+ dl : U64) → Π (+ idle : U64) → Out :=
  λ (+ fin : U64) → λ (+ s : Slice) → λ (+ max : U64) → λ (+ now : U64) → λ (+ dl : U64) → λ (+ idle : U64) →
    match (classify s) motive (λ _ → Out)
      | classified st _keep => onStatus st fin s max now dl idle

def baseOf : run Π (+ left : U64) → Π (+ owed : U64) → U64 :=
  λ (+ left : U64) → λ (+ owed : U64) →
    match (u64eq left (toU64 0)) motive (λ _ → U64)
      | true => owed
      | false => left

def pastEnd : run Π (+ buf : Slice) → Bool :=
  λ (+ buf : Slice) → u64lt (framedEnd buf) (sliceLen buf)

def tailOf : run Π (+ buf : Slice) → Slice :=
  λ (+ buf : Slice) →
    slice buf (framedEnd buf) (subi (sliceLen buf) (framedEnd buf))

-- keep 1 closes. keep 0 classifies bytes past this request, or
-- returns to idle when the buffer holds nothing past it.
-- The caller passes only the unconsumed slice. That slice still
-- starts with the request whose response just finished. tailOf
-- drops that framed prefix. The next write passes that tail, not
-- the original buffer. Passing the full two-GET buffer again, after
-- the pipelined reply, strips the first request a second time and
-- classifies that same tail as another reply. That re-pass is
-- outside the contract: pipe-done passes the tail and is idle,
-- pipe-full-again passes twoGet again and is another reply, and
-- pipe-again-differs is that those spans are not the same.
def finishWrite : run Π (+ code : U64) → Π (+ keep : U64) → Π (+ buf : Slice) → Π (+ max : U64) → Π (+ now : U64) → Π (+ dl : U64) → Π (+ idle : U64) → Out :=
  λ (+ code : U64) → λ (+ keep : U64) → λ (+ buf : Slice) → λ (+ max : U64) → λ (+ now : U64) → λ (+ dl : U64) → λ (+ idle : U64) →
    match (u64eq keep (toU64 1)) motive (λ _ → Out)
      | true => quiet code
      | false =>
          (match (pastEnd buf) motive (λ _ → Out)
            | true => onBuf (toU64 0) (tailOf buf) max now dl idle
            | false => idleAt now dl idle)

def writeFact : run Π (+ phase : U64) → Π (+ code : U64) → Π (+ left : U64) → Π (+ keep : U64) → Π (+ fact : U64) → Π (+ n : U64) → Π (+ owed : U64) → Π (+ buf : Slice) → Π (+ max : U64) → Π (+ now : U64) → Π (+ dl : U64) → Π (+ idle : U64) → Out :=
  λ (+ phase : U64) → λ (+ code : U64) → λ (+ left : U64) → λ (+ keep : U64) → λ (+ fact : U64) → λ (+ n : U64) → λ (+ owed : U64) → λ (+ buf : Slice) → λ (+ max : U64) → λ (+ now : U64) → λ (+ dl : U64) → λ (+ idle : U64) →
    match (u64eq fact factWrote) motive (λ _ → Out)
      | true =>
          (match (u64lt n (baseOf left owed)) motive (λ _ → Out)
            | true => still phase code (subi (baseOf left owed) n) keep
            | false => finishWrite code keep buf max now dl idle)
      | false =>
          (match (u64eq fact factFailed) motive (λ _ → Out)
            | true => quiet code
            | false =>
                (match (u64eq fact factPeer) motive (λ _ → Out)
                  | true => still phase code left (toU64 1)
                  | false =>
                      (match (u64eq fact factNow) motive (λ _ → Out)
                        | true => still phase code left keep
                        | false =>
                            (match (u64eq fact factBytes) motive (λ _ → Out)
                              | true => still phase code left keep
                              | false => outside))))

def readFact : run Π (+ fact : U64) → Π (+ s : Slice) → Π (+ max : U64) → Π (+ now : U64) → Π (+ dl : U64) → Π (+ idle : U64) → Out :=
  λ (+ fact : U64) → λ (+ s : Slice) → λ (+ max : U64) → λ (+ now : U64) → λ (+ dl : U64) → λ (+ idle : U64) →
    match (u64eq fact factAccepted) motive (λ _ → Out)
      | true => moreAt now (toU64 0) idle
      | false =>
          (match (u64eq fact factBytes) motive (λ _ → Out)
            | true => onBuf (toU64 0) s max now dl idle
            | false =>
                (match (u64eq fact factPeer) motive (λ _ → Out)
                  | true =>
                      (match (u64eq (sliceLen s) (toU64 0)) motive (λ _ → Out)
                        | true => quiet (toU64 0)
                        | false => onBuf (toU64 1) s max now dl idle)
                  | false =>
                      (match (u64eq fact factNow) motive (λ _ → Out)
                        | true => quiet (toU64 0)
                        | false =>
                            (match (or (u64eq fact factWrote) (u64eq fact factFailed)) motive (λ _ → Out)
                              | true => moreAt now dl idle
                              | false => outside))))

def idleFact : run Π (+ fact : U64) → Π (+ s : Slice) → Π (+ max : U64) → Π (+ now : U64) → Π (+ dl : U64) → Π (+ idle : U64) → Out :=
  λ (+ fact : U64) → λ (+ s : Slice) → λ (+ max : U64) → λ (+ now : U64) → λ (+ dl : U64) → λ (+ idle : U64) →
    match (u64eq fact factBytes) motive (λ _ → Out)
      | true => onBuf (toU64 0) s max now dl idle
      | false =>
          (match (u64eq fact factPeer) motive (λ _ → Out)
            | true =>
                (match (u64eq (sliceLen s) (toU64 0)) motive (λ _ → Out)
                  | true => quiet (toU64 0)
                  | false => onBuf (toU64 1) s max now dl idle)
            | false =>
                (match (u64eq fact factNow) motive (λ _ → Out)
                  | true => quiet (toU64 0)
                  | false =>
                      (match (or (u64eq fact factWrote) (u64eq fact factFailed)) motive (λ _ → Out)
                        | true => idleAt now dl idle
                        | false => outside)))

def stepFact : run Π (+ st : St) → Π (+ fact : U64) → Π (+ buf : Slice) → Π (+ max : U64) → Π (+ n : U64) → Π (+ owed : U64) → Π (+ now : U64) → Π (+ dl : U64) → Π (+ idle : U64) → Out :=
  λ (+ st : St) → λ (+ fact : U64) → λ (+ buf : Slice) → λ (+ max : U64) → λ (+ n : U64) → λ (+ owed : U64) → λ (+ now : U64) → λ (+ dl : U64) → λ (+ idle : U64) →
    match st motive (λ _ → Out)
      | st phase code left keep =>
          (match (or (u64eq phase (toU64 2)) (u64eq phase (toU64 5))) motive (λ _ → Out)
            | true => quiet code
            | false =>
                (match (or (u64eq phase (toU64 1)) (u64eq phase (toU64 3))) motive (λ _ → Out)
                  | true => writeFact phase code left keep fact n owed buf max now dl idle
                  | false =>
                      (match (u64eq phase (toU64 4)) motive (λ _ → Out)
                        | true => idleFact fact buf max now dl idle
                        | false => readFact fact buf max now dl idle)))

def step0 : run Π (+ st : St) → Π (+ fact : U64) → Π (+ buf : Slice) → Π (+ max : U64) → Π (+ n : U64) → Π (+ owed : U64) → Out :=
  λ (+ st : St) → λ (+ fact : U64) → λ (+ buf : Slice) → λ (+ max : U64) → λ (+ n : U64) → λ (+ owed : U64) →
    stepFact st fact buf max n owed (toU64 0) (toU64 0) (toU64 0)

-- Phase 5 is a handler that closed before a span was parked. The
-- image stays in handle. A later fact is quiet, like phase 2.
def shutHandle : run Π (+ code : U64) → Out :=
  λ (+ code : U64) →
    out (toU64 5) code (toU64 1) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 1)

-- close_after or a 4xx/5xx forces keep 1. Otherwise the request keep stands.
def keepHand : run Π (+ reqKeep : U64) → Π (+ hclose : U64) → Π (+ hbad : U64) → U64 :=
  λ (+ reqKeep : U64) → λ (+ hclose : U64) → λ (+ hbad : U64) →
    match (u64eq hbad (toU64 1)) motive (λ _ → U64)
      | true => toU64 1
      | false =>
          (match (u64eq hclose (toU64 1)) motive (λ _ → U64)
            | true => toU64 1
            | false => reqKeep)

-- span 3 content-length pull, 4 chunked pull, 5 close-delimited pull.
def spanPull : run Π (+ keep : U64) → Π (+ span : U64) → Out :=
  λ (+ keep : U64) → λ (+ span : U64) →
    out (toU64 3) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 1) span (toU64 0) (toU64 0) (toU64 0) keep

-- A buffered body that does not fit, after a commit, is a 500 span.
def oweFit : run Out :=
  still (toU64 3) (toU64 500) (toU64 0) (toU64 1)

def hand : run Π (+ reqKeep : U64) → Π (+ hclose : U64) → Π (+ hbad : U64) → Π (+ howe : U64) → Π (+ href : U64) → Π (+ hpull : U64) → Π (+ hver : U64) → Π (+ hhead : U64) → Π (+ hfit : U64) → Out :=
  λ (+ reqKeep : U64) → λ (+ hclose : U64) → λ (+ hbad : U64) → λ (+ howe : U64) → λ (+ href : U64) → λ (+ hpull : U64) → λ (+ hver : U64) → λ (+ hhead : U64) → λ (+ hfit : U64) →
    match (u64eq href (toU64 1)) motive (λ _ → Out)
      | true =>
          (match (u64eq howe (toU64 1)) motive (λ _ → Out)
            | true => shutHandle (toU64 500)
            | false => shutHandle (toU64 0))
      | false =>
          (match (u64eq hpull (toU64 1)) motive (λ _ → Out)
            | true => spanPull (keepHand reqKeep hclose hbad) (toU64 3)
            | false =>
                (match (u64eq hpull (toU64 2)) motive (λ _ → Out)
                  | true =>
                      (match (or (u64eq hhead (toU64 1)) (u64eq hver (toU64 0))) motive (λ _ → Out)
                        | true => spanPull (toU64 1) (toU64 5)
                        | false => spanPull (keepHand reqKeep hclose hbad) (toU64 4))
                  | false =>
                      (match (u64eq hfit (toU64 0)) motive (λ _ → Out)
                        | true =>
                            (match (u64eq howe (toU64 1)) motive (λ _ → Out)
                              | true => oweFit
                              | false => shutHandle (toU64 0))
                        | false => reply (keepHand reqKeep hclose hbad))))

