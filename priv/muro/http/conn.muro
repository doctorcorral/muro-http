-- One finite step of an HTTP/1 connection.
--
-- The C shim owns the socket, the buffer, and the clock. It calls step
-- and performs the action. This book does not loop and does not name
-- the session in session.muro: a run that names a session is refused,
-- and C still emits no session stepper. The link is the trace test.
--
-- phase: 0 read, 1 decide, 2 write, 3 idle, 4 closed
-- half:  0 open, 1 peer has shut its write (no further read)
-- keep:  0 keep-alive, 1 close after the response
-- action: 0 none, 1 want-read, 2 write, 3 close, 4 call-decide
-- timer: 0 disarmed, 1 armed
-- Ev tag: 0 bytes, 1 eof, 2 progress, 3 done, 4 error, 5 tick, 6 db
-- A db event is n0 auth, n1 body, n2 like, n3 db, n4 id, in decide's
-- constructor order. progress stores the delta in n0.
-- writeLen is 16 for every response. The shim owns the bytes; the
-- range is writeOff and writeLen. code, err, and act are decide's tags.
-- endOff is the first byte after the request. more is 1 when the
-- buffer holds bytes past that, so the shim can re-step the tail.
--
-- Closed is stable: phase 4, action close, and every event returns
-- that same state. It asks for no read and no write.
import "request.muro"

unboxed data Conn : Type where
  conn : Π (+ phase : U64) → Π (+ half : U64) → Π (+ keep : U64) → Π (+ verb : U64) → Π (+ path : U64) → Π (+ idc : U64) → Π (+ action : U64) → Π (+ timer : U64) → Π (+ code : U64) → Π (+ err : U64) → Π (+ act : U64) → Π (+ off : U64) → Π (+ len : U64) → Π (+ endOff : U64) → Π (+ more : U64) → Conn

unboxed data Ev : Type where
  ev : Π (+ tag : U64) → Π (+ buf : Slice) → Π (+ n0 : U64) → Π (+ n1 : U64) → Π (+ n2 : U64) → Π (+ n3 : U64) → Π (+ n4 : U64) → Ev

data Mode : Type where
  mode-read : Mode
  mode-decide : Mode
  mode-write : Mode
  mode-idle : Mode
  mode-half : Mode
  mode-closed : Mode

data Do : Type where
  do-none : Do
  do-read : Do
  do-write : Do
  do-close : Do
  do-decide : Do

data Flag : Type where
  flag-no : Flag
  flag-yes : Flag

def respLen : run U64 :=
  toU64 16

def shut : run Conn :=
  conn (toU64 4) (toU64 0) (toU64 1) (toU64 0) (toU64 0) (toU64 0) (toU64 3) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0)

def waitRead : run Conn :=
  conn (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 1) (toU64 1) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0)

def begin : run Conn :=
  waitRead

def hold : run Π (+ phase : U64) → Π (+ half : U64) → Π (+ keep : U64) → Π (+ verb : U64) → Π (+ path : U64) → Π (+ idc : U64) → Π (+ action : U64) → Π (+ timer : U64) → Π (+ code : U64) → Π (+ err : U64) → Π (+ act : U64) → Π (+ off : U64) → Π (+ len : U64) → Π (+ endOff : U64) → Π (+ more : U64) → Conn :=
  λ (+ phase : U64) → λ (+ half : U64) → λ (+ keep : U64) → λ (+ verb : U64) → λ (+ path : U64) → λ (+ idc : U64) → λ (+ action : U64) → λ (+ timer : U64) → λ (+ code : U64) → λ (+ err : U64) → λ (+ act : U64) → λ (+ off : U64) → λ (+ len : U64) → λ (+ endOff : U64) → λ (+ more : U64) →
    conn phase half keep verb path idc action timer code err act off len endOff more

def idleOf : run Π (+ endOff : U64) → Π (+ more : U64) → Conn :=
  λ (+ endOff : U64) → λ (+ more : U64) →
    conn (toU64 3) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 1) (toU64 1) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0) endOff more

def badWrite : run Π (+ fin : U64) → Conn :=
  λ (+ fin : U64) →
    conn (toU64 2) fin (toU64 1) (toU64 0) (toU64 0) (toU64 0) (toU64 2) (toU64 0) (toU64 2) (toU64 7) (toU64 6) (toU64 0) respLen (toU64 0) (toU64 0)

def verbTag : run Π (v : Verb) → U64 :=
  λ (v : Verb) →
    match v motive (λ _ → U64)
      | verb-get => toU64 0
      | verb-post => toU64 1
      | verb-other => toU64 2

def pathTag : run Π (p : PathShape) → U64 :=
  λ (p : PathShape) →
    match p motive (λ _ → U64)
      | path-health => toU64 0
      | path-feed => toU64 1
      | path-posts => toU64 2
      | path-post-id => toU64 3
      | path-post-like => toU64 4
      | path-other => toU64 5

def idTag : run Π (i : IdClass) → U64 :=
  λ (i : IdClass) →
    match i motive (λ _ → U64)
      | id-none => toU64 0
      | id-bad => toU64 1
      | id-unknown => toU64 2
      | id-missing => toU64 3
      | id-present => toU64 4

def keepTag : run Π (k : Keep) → U64 :=
  λ (k : Keep) →
    match k motive (λ _ → U64)
      | keep-yes => toU64 0
      | keep-no => toU64 1

def codeTag : run Π (c : StatusCode) → U64 :=
  λ (c : StatusCode) →
    match c motive (λ _ → U64)
      | st-200 => toU64 0
      | st-201 => toU64 1
      | st-400 => toU64 2
      | st-401 => toU64 3
      | st-404 => toU64 4
      | st-500 => toU64 5
      | st-503 => toU64 6
      | st-observe => toU64 7

def errTag : run Π (e : ErrKind) → U64 :=
  λ (e : ErrKind) →
    match e motive (λ _ → U64)
      | err-none => toU64 0
      | err-not-found => toU64 1
      | err-invalid-id => toU64 2
      | err-post-missing => toU64 3
      | err-missing-bearer => toU64 4
      | err-bad-token => toU64 5
      | err-bad-payload => toU64 6
      | err-malformed => toU64 7
      | err-body-required => toU64 8
      | err-body-long => toU64 9
      | err-internal => toU64 10
      | err-db => toU64 11
      | err-observe => toU64 12

def verbFrom : run Π (+ t : U64) → Verb :=
  λ (+ t : U64) →
    match (u64eq t (toU64 0)) motive (λ _ → Verb)
      | true => verb-get
      | false =>
          (match (u64eq t (toU64 1)) motive (λ _ → Verb)
            | true => verb-post
            | false => verb-other)

def pathFrom : run Π (+ t : U64) → PathShape :=
  λ (+ t : U64) →
    match (u64eq t (toU64 0)) motive (λ _ → PathShape)
      | true => path-health
      | false =>
          (match (u64eq t (toU64 1)) motive (λ _ → PathShape)
            | true => path-feed
            | false =>
                (match (u64eq t (toU64 2)) motive (λ _ → PathShape)
                  | true => path-posts
                  | false =>
                      (match (u64eq t (toU64 3)) motive (λ _ → PathShape)
                        | true => path-post-id
                        | false =>
                            (match (u64eq t (toU64 4)) motive (λ _ → PathShape)
                              | true => path-post-like
                              | false => path-other))))

def idFrom : run Π (+ t : U64) → IdClass :=
  λ (+ t : U64) →
    match (u64eq t (toU64 0)) motive (λ _ → IdClass)
      | true => id-none
      | false =>
          (match (u64eq t (toU64 1)) motive (λ _ → IdClass)
            | true => id-bad
            | false =>
                (match (u64eq t (toU64 2)) motive (λ _ → IdClass)
                  | true => id-unknown
                  | false =>
                      (match (u64eq t (toU64 3)) motive (λ _ → IdClass)
                        | true => id-missing
                        | false => id-present)))

def authFrom : run Π (+ t : U64) → AuthClass :=
  λ (+ t : U64) →
    match (u64eq t (toU64 0)) motive (λ _ → AuthClass)
      | true => auth-absent
      | false =>
          (match (u64eq t (toU64 1)) motive (λ _ → AuthClass)
            | true => auth-bad-token
            | false =>
                (match (u64eq t (toU64 2)) motive (λ _ → AuthClass)
                  | true => auth-bad-payload
                  | false => auth-ok))

def bodyFrom : run Π (+ t : U64) → BodyClass :=
  λ (+ t : U64) →
    match (u64eq t (toU64 0)) motive (λ _ → BodyClass)
      | true => body-none
      | false =>
          (match (u64eq t (toU64 1)) motive (λ _ → BodyClass)
            | true => body-malformed
            | false =>
                (match (u64eq t (toU64 2)) motive (λ _ → BodyClass)
                  | true => body-required
                  | false =>
                      (match (u64eq t (toU64 3)) motive (λ _ → BodyClass)
                        | true => body-too-long
                        | false => body-ok)))

def likeFrom : run Π (+ t : U64) → LikeFact :=
  λ (+ t : U64) →
    match (u64eq t (toU64 0)) motive (λ _ → LikeFact)
      | true => like-none
      | false =>
          (match (u64eq t (toU64 1)) motive (λ _ → LikeFact)
            | true => like-unknown
            | false =>
                (match (u64eq t (toU64 2)) motive (λ _ → LikeFact)
                  | true => like-new
                  | false => like-again))

def dbFrom : run Π (+ t : U64) → DbFact :=
  λ (+ t : U64) →
    match (u64eq t (toU64 0)) motive (λ _ → DbFact)
      | true => db-unknown
      | false =>
          (match (u64eq t (toU64 1)) motive (λ _ → DbFact)
            | true => db-down
            | false => db-ok)

def keepBit : run Π (+ fin : U64) → Π (k : Keep) → U64 :=
  λ (+ fin : U64) → λ (k : Keep) →
    match (u64eq fin (toU64 1)) motive (λ _ → U64)
      | true => toU64 1
      | false => keepTag k

def endAt : run Π (+ buf : Slice) → U64 :=
  λ (+ buf : Slice) → addi (bodyAt buf) (bodyLen buf)

def moreAt : run Π (+ buf : Slice) → U64 :=
  λ (+ buf : Slice) →
    match (u64lt (endAt buf) (sliceLen buf)) motive (λ _ → U64)
      | true => toU64 1
      | false => toU64 0

def decideWait : run Π (+ fin : U64) → Π (+ buf : Slice) → Π (verb : Verb) → Π (path : PathShape) → Π (idc : IdClass) → Π (k : Keep) → Conn :=
  λ (+ fin : U64) → λ (+ buf : Slice) → λ (verb : Verb) → λ (path : PathShape) → λ (idc : IdClass) → λ (k : Keep) →
    conn (toU64 1) fin (keepBit fin k) (verbTag verb) (pathTag path) (idTag idc) (toU64 4) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0) (endAt buf) (moreAt buf)

def onClass : run Π (+ fin : U64) → Π (+ buf : Slice) → Π (c : Classified) → Conn :=
  λ (+ fin : U64) → λ (+ buf : Slice) → λ (c : Classified) →
    match c motive (λ _ → Conn)
      | classified st verb path idc keep _mark _body =>
          (match st motive (λ _ → Conn)
            | status-ok => decideWait fin buf verb path idc keep
            | status-malformed => badWrite fin
            | status-need-more =>
                (match (u64eq fin (toU64 1)) motive (λ _ → Conn)
                  | true => badWrite fin
                  | false => waitRead))

def onBytes : run Π (+ fin : U64) → Π (+ buf : Slice) → Conn :=
  λ (+ fin : U64) → λ (+ buf : Slice) →
    onClass fin buf (classify buf)

def onEof : run Π (+ buf : Slice) → Conn :=
  λ (+ buf : Slice) →
    match (u64eq (sliceLen buf) (toU64 0)) motive (λ _ → Conn)
      | true => shut
      | false => onBytes (toU64 1) buf

def addCap : run Π (+ off : U64) → Π (+ n : U64) → Π (+ lim : U64) → U64 :=
  λ (+ off : U64) → λ (+ n : U64) → λ (+ lim : U64) →
    match (u64lt (addi off n) lim) motive (λ _ → U64)
      | true => addi off n
      | false =>
          (match (u64lt off lim) motive (λ _ → U64)
            | true => lim
            | false => off)

def finish : run Π (+ half : U64) → Π (+ keep : U64) → Π (+ endOff : U64) → Π (+ more : U64) → Conn :=
  λ (+ half : U64) → λ (+ keep : U64) → λ (+ endOff : U64) → λ (+ more : U64) →
    match (or (u64eq half (toU64 1)) (u64eq keep (toU64 1))) motive (λ _ → Conn)
      | true => shut
      | false => idleOf endOff more

def writeOf : run Π (+ half : U64) → Π (+ keep : U64) → Π (+ verb : U64) → Π (+ path : U64) → Π (+ idc : U64) → Π (+ endOff : U64) → Π (+ more : U64) → Π (code : StatusCode) → Π (err : ErrKind) → Π (+ actn : U64) → Conn :=
  λ (+ half : U64) → λ (+ keep : U64) → λ (+ verb : U64) → λ (+ path : U64) → λ (+ idc : U64) → λ (+ endOff : U64) → λ (+ more : U64) → λ (code : StatusCode) → λ (err : ErrKind) → λ (+ actn : U64) →
    conn (toU64 2) half keep verb path idc (toU64 2) (toU64 0) (codeTag code) (errTag err) actn (toU64 0) respLen endOff more

def observeOf : run Π (+ half : U64) → Π (+ keep : U64) → Π (+ verb : U64) → Π (+ path : U64) → Π (+ idc : U64) → Π (+ endOff : U64) → Π (+ more : U64) → Π (code : StatusCode) → Π (err : ErrKind) → Conn :=
  λ (+ half : U64) → λ (+ keep : U64) → λ (+ verb : U64) → λ (+ path : U64) → λ (+ idc : U64) → λ (+ endOff : U64) → λ (+ more : U64) → λ (code : StatusCode) → λ (err : ErrKind) →
    conn (toU64 1) half keep verb path idc (toU64 4) (toU64 0) (codeTag code) (errTag err) (toU64 7) (toU64 0) (toU64 0) endOff more

def afterDecide : run Π (+ half : U64) → Π (+ keep : U64) → Π (+ verb : U64) → Π (+ path : U64) → Π (+ idc : U64) → Π (+ endOff : U64) → Π (+ more : U64) → Π (d : Decision) → Conn :=
  λ (+ half : U64) → λ (+ keep : U64) → λ (+ verb : U64) → λ (+ path : U64) → λ (+ idc : U64) → λ (+ endOff : U64) → λ (+ more : U64) → λ (d : Decision) →
    match d motive (λ _ → Conn)
      | decided code err act =>
          (match act motive (λ _ → Conn)
            | act-health => writeOf half keep verb path idc endOff more code err (toU64 0)
            | act-feed => writeOf half keep verb path idc endOff more code err (toU64 1)
            | act-read => writeOf half keep verb path idc endOff more code err (toU64 2)
            | act-create => writeOf half keep verb path idc endOff more code err (toU64 3)
            | act-like-new => writeOf half keep verb path idc endOff more code err (toU64 4)
            | act-like-again => writeOf half keep verb path idc endOff more code err (toU64 5)
            | act-error => writeOf half keep verb path idc endOff more code err (toU64 6)
            | act-observe => observeOf half keep verb path idc endOff more code err)

def onRead : run Π (+ phase : U64) → Π (+ half : U64) → Π (+ keep : U64) → Π (+ verb : U64) → Π (+ path : U64) → Π (+ idc : U64) → Π (+ action : U64) → Π (+ timer : U64) → Π (+ code : U64) → Π (+ err : U64) → Π (+ act : U64) → Π (+ off : U64) → Π (+ len : U64) → Π (+ endOff : U64) → Π (+ more : U64) → Π (+ tag : U64) → Π (+ buf : Slice) → Conn :=
  λ (+ phase : U64) → λ (+ half : U64) → λ (+ keep : U64) → λ (+ verb : U64) → λ (+ path : U64) → λ (+ idc : U64) → λ (+ action : U64) → λ (+ timer : U64) → λ (+ code : U64) → λ (+ err : U64) → λ (+ act : U64) → λ (+ off : U64) → λ (+ len : U64) → λ (+ endOff : U64) → λ (+ more : U64) → λ (+ tag : U64) → λ (+ buf : Slice) →
    match (u64eq tag (toU64 0)) motive (λ _ → Conn)
      | true => onBytes (toU64 0) buf
      | false =>
          (match (u64eq tag (toU64 1)) motive (λ _ → Conn)
            | true => onEof buf
            | false =>
                (match (u64eq tag (toU64 5)) motive (λ _ → Conn)
                  | true => shut
                  | false => hold phase half keep verb path idc action timer code err act off len endOff more))

def onDecide : run Π (+ phase : U64) → Π (+ half : U64) → Π (+ keep : U64) → Π (+ verb : U64) → Π (+ path : U64) → Π (+ idc : U64) → Π (+ action : U64) → Π (+ timer : U64) → Π (+ code : U64) → Π (+ err : U64) → Π (+ act : U64) → Π (+ off : U64) → Π (+ len : U64) → Π (+ endOff : U64) → Π (+ more : U64) → Π (+ tag : U64) → Π (+ n0 : U64) → Π (+ n1 : U64) → Π (+ n2 : U64) → Π (+ n3 : U64) → Π (+ n4 : U64) → Conn :=
  λ (+ phase : U64) → λ (+ half : U64) → λ (+ keep : U64) → λ (+ verb : U64) → λ (+ path : U64) → λ (+ idc : U64) → λ (+ action : U64) → λ (+ timer : U64) → λ (+ code : U64) → λ (+ err : U64) → λ (+ act : U64) → λ (+ off : U64) → λ (+ len : U64) → λ (+ endOff : U64) → λ (+ more : U64) → λ (+ tag : U64) → λ (+ n0 : U64) → λ (+ n1 : U64) → λ (+ n2 : U64) → λ (+ n3 : U64) → λ (+ n4 : U64) →
    match (u64eq tag (toU64 6)) motive (λ _ → Conn)
      | true =>
          afterDecide half keep verb path n4 endOff more
            (decide (verbFrom verb) (pathFrom path) (idFrom n4) (authFrom n0) (bodyFrom n1) (likeFrom n2) (dbFrom n3))
      | false =>
          (match (u64eq tag (toU64 1)) motive (λ _ → Conn)
            | true => conn phase (toU64 1) (toU64 1) verb path idc (toU64 4) (toU64 0) code err act off len endOff more
            | false => hold phase half keep verb path idc action timer code err act off len endOff more)

def onWrite : run Π (+ phase : U64) → Π (+ half : U64) → Π (+ keep : U64) → Π (+ verb : U64) → Π (+ path : U64) → Π (+ idc : U64) → Π (+ action : U64) → Π (+ timer : U64) → Π (+ code : U64) → Π (+ err : U64) → Π (+ act : U64) → Π (+ off : U64) → Π (+ len : U64) → Π (+ endOff : U64) → Π (+ more : U64) → Π (+ tag : U64) → Π (+ n0 : U64) → Conn :=
  λ (+ phase : U64) → λ (+ half : U64) → λ (+ keep : U64) → λ (+ verb : U64) → λ (+ path : U64) → λ (+ idc : U64) → λ (+ action : U64) → λ (+ timer : U64) → λ (+ code : U64) → λ (+ err : U64) → λ (+ act : U64) → λ (+ off : U64) → λ (+ len : U64) → λ (+ endOff : U64) → λ (+ more : U64) → λ (+ tag : U64) → λ (+ n0 : U64) →
    match (u64eq tag (toU64 2)) motive (λ _ → Conn)
      | true => conn phase half keep verb path idc (toU64 2) (toU64 0) code err act (addCap off n0 len) len endOff more
      | false =>
          (match (u64eq tag (toU64 3)) motive (λ _ → Conn)
            | true => finish half keep endOff more
            | false =>
                (match (u64eq tag (toU64 4)) motive (λ _ → Conn)
                  | true => shut
                  | false =>
                      (match (u64eq tag (toU64 1)) motive (λ _ → Conn)
                        | true => conn phase (toU64 1) (toU64 1) verb path idc (toU64 2) (toU64 0) code err act off len endOff more
                        | false => hold phase half keep verb path idc action timer code err act off len endOff more)))

def onIdle : run Π (+ phase : U64) → Π (+ half : U64) → Π (+ keep : U64) → Π (+ verb : U64) → Π (+ path : U64) → Π (+ idc : U64) → Π (+ action : U64) → Π (+ timer : U64) → Π (+ code : U64) → Π (+ err : U64) → Π (+ act : U64) → Π (+ off : U64) → Π (+ len : U64) → Π (+ endOff : U64) → Π (+ more : U64) → Π (+ tag : U64) → Π (+ buf : Slice) → Conn :=
  λ (+ phase : U64) → λ (+ half : U64) → λ (+ keep : U64) → λ (+ verb : U64) → λ (+ path : U64) → λ (+ idc : U64) → λ (+ action : U64) → λ (+ timer : U64) → λ (+ code : U64) → λ (+ err : U64) → λ (+ act : U64) → λ (+ off : U64) → λ (+ len : U64) → λ (+ endOff : U64) → λ (+ more : U64) → λ (+ tag : U64) → λ (+ buf : Slice) →
    match (u64eq tag (toU64 0)) motive (λ _ → Conn)
      | true => onBytes (toU64 0) buf
      | false =>
          (match (u64eq tag (toU64 1)) motive (λ _ → Conn)
            | true => onEof buf
            | false =>
                (match (u64eq tag (toU64 5)) motive (λ _ → Conn)
                  | true => shut
                  | false => hold phase half keep verb path idc action timer code err act off len endOff more))

def stepAt : run Π (+ phase : U64) → Π (+ half : U64) → Π (+ keep : U64) → Π (+ verb : U64) → Π (+ path : U64) → Π (+ idc : U64) → Π (+ action : U64) → Π (+ timer : U64) → Π (+ code : U64) → Π (+ err : U64) → Π (+ act : U64) → Π (+ off : U64) → Π (+ len : U64) → Π (+ endOff : U64) → Π (+ more : U64) → Π (+ tag : U64) → Π (+ buf : Slice) → Π (+ n0 : U64) → Π (+ n1 : U64) → Π (+ n2 : U64) → Π (+ n3 : U64) → Π (+ n4 : U64) → Conn :=
  λ (+ phase : U64) → λ (+ half : U64) → λ (+ keep : U64) → λ (+ verb : U64) → λ (+ path : U64) → λ (+ idc : U64) → λ (+ action : U64) → λ (+ timer : U64) → λ (+ code : U64) → λ (+ err : U64) → λ (+ act : U64) → λ (+ off : U64) → λ (+ len : U64) → λ (+ endOff : U64) → λ (+ more : U64) → λ (+ tag : U64) → λ (+ buf : Slice) → λ (+ n0 : U64) → λ (+ n1 : U64) → λ (+ n2 : U64) → λ (+ n3 : U64) → λ (+ n4 : U64) →
    match (u64eq phase (toU64 4)) motive (λ _ → Conn)
      | true => shut
      | false =>
          (match (u64eq phase (toU64 0)) motive (λ _ → Conn)
            | true => onRead phase half keep verb path idc action timer code err act off len endOff more tag buf
            | false =>
                (match (u64eq phase (toU64 1)) motive (λ _ → Conn)
                  | true => onDecide phase half keep verb path idc action timer code err act off len endOff more tag n0 n1 n2 n3 n4
                  | false =>
                      (match (u64eq phase (toU64 2)) motive (λ _ → Conn)
                        | true => onWrite phase half keep verb path idc action timer code err act off len endOff more tag n0
                        | false =>
                            (match (u64eq phase (toU64 3)) motive (λ _ → Conn)
                              | true => onIdle phase half keep verb path idc action timer code err act off len endOff more tag buf
                              | false => shut))))

def step : run Π (+ st : Conn) → Π (+ ev : Ev) → Conn :=
  λ (+ st : Conn) → λ (+ ev : Ev) →
    match st motive (λ _ → Conn)
      | conn phase half keep verb path idc action timer code err act off len endOff more =>
          (match ev motive (λ _ → Conn)
            | ev tag buf n0 n1 n2 n3 n4 =>
                stepAt phase half keep verb path idc action timer code err act off len endOff more tag buf n0 n1 n2 n3 n4)

def modeOf : run Π (+ phase : U64) → Π (+ half : U64) → Mode :=
  λ (+ phase : U64) → λ (+ half : U64) →
    match (u64eq phase (toU64 4)) motive (λ _ → Mode)
      | true => mode-closed
      | false =>
          (match (u64eq half (toU64 1)) motive (λ _ → Mode)
            | true => mode-half
            | false =>
                (match (u64eq phase (toU64 0)) motive (λ _ → Mode)
                  | true => mode-read
                  | false =>
                      (match (u64eq phase (toU64 1)) motive (λ _ → Mode)
                        | true => mode-decide
                        | false =>
                            (match (u64eq phase (toU64 2)) motive (λ _ → Mode)
                              | true => mode-write
                              | false =>
                                  (match (u64eq phase (toU64 3)) motive (λ _ → Mode)
                                    | true => mode-idle
                                    | false => mode-closed)))))

def mode : run Π (+ st : Conn) → Mode :=
  λ (+ st : Conn) →
    match st motive (λ _ → Mode)
      | conn phase half _keep _verb _path _idc _action _timer _code _err _act _off _len _endOff _more =>
          modeOf phase half

def doOf : run Π (+ n : U64) → Do :=
  λ (+ n : U64) →
    match (u64eq n (toU64 0)) motive (λ _ → Do)
      | true => do-none
      | false =>
          (match (u64eq n (toU64 1)) motive (λ _ → Do)
            | true => do-read
            | false =>
                (match (u64eq n (toU64 2)) motive (λ _ → Do)
                  | true => do-write
                  | false =>
                      (match (u64eq n (toU64 3)) motive (λ _ → Do)
                        | true => do-close
                        | false =>
                            (match (u64eq n (toU64 4)) motive (λ _ → Do)
                              | true => do-decide
                              | false => do-none))))

def actionOf : run Π (+ st : Conn) → Do :=
  λ (+ st : Conn) →
    match st motive (λ _ → Do)
      | conn _phase _half _keep _verb _path _idc action _timer _code _err _act _off _len _endOff _more =>
          doOf action

def flagOf : run Π (+ n : U64) → Flag :=
  λ (+ n : U64) →
    match (u64eq n (toU64 0)) motive (λ _ → Flag)
      | true => flag-no
      | false => flag-yes

def moreFlag : run Π (+ st : Conn) → Flag :=
  λ (+ st : Conn) →
    match st motive (λ _ → Flag)
      | conn _phase _half _keep _verb _path _idc _action _timer _code _err _act _off _len _endOff more =>
          flagOf more

def evBytes : run Π (+ s : Slice) → Ev :=
  λ (+ s : Slice) → ev (toU64 0) s (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0)

def evEof : run Π (+ s : Slice) → Ev :=
  λ (+ s : Slice) → ev (toU64 1) s (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0)

def evProgress : run Π (+ n : U64) → Ev :=
  λ (+ n : U64) → ev (toU64 2) b"" n (toU64 0) (toU64 0) (toU64 0) (toU64 0)

def evDone : run Ev :=
  ev (toU64 3) b"" (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0)

def evError : run Ev :=
  ev (toU64 4) b"" (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0)

def evTick : run Ev :=
  ev (toU64 5) b"" (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0)

def evDb : run Π (+ auth : U64) → Π (+ body : U64) → Π (+ like : U64) → Π (+ db : U64) → Π (+ idc : U64) → Ev :=
  λ (+ auth : U64) → λ (+ body : U64) → λ (+ like : U64) → λ (+ db : U64) → λ (+ idc : U64) →
    ev (toU64 6) b"" auth body like db idc

def evDbOk : run Ev :=
  evDb (toU64 0) (toU64 0) (toU64 0) (toU64 2) (toU64 0)

def evDbAsk : run Ev :=
  evDb (toU64 0) (toU64 0) (toU64 0) (toU64 0) (toU64 0)

-- The equations below call these nullary runs. An equation whose
-- argument is the unboxed state is proved here and skipped by ExUnit,
-- because that normal form is a machine term. The nullary result is
-- declared data, so the host suite can run it.

def healthReq : run Slice :=
  b"GET /health HTTP/1.1\r\n\r\n"

def feedReq : run Slice :=
  b"GET /feed HTTP/1.1\r\n\r\n"

def partialReq : run Slice :=
  b"GET /health HTTP/1.1\r\n"

def closeReq : run Slice :=
  b"GET /health HTTP/1.1\r\nConnection: close\r\n\r\n"

def http10Req : run Slice :=
  b"GET /health HTTP/1.0\r\n\r\n"

def badReq : run Slice :=
  b"GET/feed HTTP/1.1\r\n\r\n"

def pipeReq : run Slice :=
  b"GET /health HTTP/1.1\r\n\r\nGET /feed HTTP/1.1\r\n\r\n"

def sawBegin : run Mode :=
  mode begin

def sawBeginDo : run Do :=
  actionOf begin

def sawShutDo : run Do :=
  actionOf shut

def sawTickRead : run Mode :=
  mode (step begin evTick)

def sawEofEmpty : run Mode :=
  mode (step begin (evEof b""))

def sawNeed : run Mode :=
  mode (step begin (evBytes partialReq))

def sawHealth : run Mode :=
  mode (step begin (evBytes healthReq))

def sawHealthDo : run Do :=
  actionOf (step begin (evBytes healthReq))

def sawHealthOne : run Flag :=
  moreFlag (step begin (evBytes healthReq))

def sawAsk : run Mode :=
  mode (step (step begin (evBytes healthReq)) evDbAsk)

def sawWrite : run Mode :=
  mode (step (step begin (evBytes healthReq)) evDbOk)

def sawWriteDo : run Do :=
  actionOf (step (step begin (evBytes healthReq)) evDbOk)

def healthWritten : run Conn :=
  step (step begin (evBytes healthReq)) evDbOk

def sawProgress : run Mode :=
  mode (step healthWritten (evProgress (toU64 8)))

def sawProgressFlag : run Flag :=
  flagOf (match (step healthWritten (evProgress (toU64 8))) motive (λ _ → U64)
    | conn _phase _half _keep _verb _path _idc _action _timer _code _err _act off _len _endOff _more => off)

def sawIdle : run Mode :=
  mode (step healthWritten evDone)

def healthIdle : run Conn :=
  step healthWritten evDone

def sawIdleTick : run Mode :=
  mode (step healthIdle evTick)

def sawSecond : run Mode :=
  mode (step healthIdle (evBytes feedReq))

def sawClose : run Mode :=
  mode (step (step (step begin (evBytes closeReq)) evDbOk) evDone)

def sawHttp10 : run Mode :=
  mode (step (step (step begin (evBytes http10Req)) evDbOk) evDone)

def sawBad : run Mode :=
  mode (step begin (evBytes badReq))

def sawBadDone : run Mode :=
  mode (step (step begin (evBytes badReq)) evDone)

def sawWerr : run Mode :=
  mode (step healthWritten evError)

def sawHalf : run Mode :=
  mode (step (step begin (evBytes healthReq)) (evEof b""))

def sawHalfWrite : run Mode :=
  mode (step (step (step begin (evBytes healthReq)) (evEof b"")) evDbOk)

def sawHalfDone : run Mode :=
  mode (step (step (step (step begin (evBytes healthReq)) (evEof b"")) evDbOk) evDone)

def sawFinReq : run Mode :=
  mode (step begin (evEof healthReq))

def sawTrunc : run Mode :=
  mode (step begin (evEof partialReq))

def sawPipe : run Flag :=
  moreFlag (step begin (evBytes pipeReq))

def sawPipeMode : run Mode :=
  mode (step begin (evBytes pipeReq))

def sawAfterDo : run Do :=
  actionOf (step shut (evBytes healthReq))

def sawAfterTick : run Do :=
  actionOf (step shut evTick)

def sawAfterMode : run Mode :=
  mode (step shut evDone)

def begin-read : evidence {sawBegin ≡ mode-read : Mode} := refl

def begin-wants-read : evidence {sawBeginDo ≡ do-read : Do} := refl

def closed-action : evidence {sawShutDo ≡ do-close : Do} := refl

def tick-from-read : evidence {sawTickRead ≡ mode-closed : Mode} := refl

def eof-empty : evidence {sawEofEmpty ≡ mode-closed : Mode} := refl

def need-more : evidence {sawNeed ≡ mode-read : Mode} := refl

def health-decide : evidence {sawHealth ≡ mode-decide : Mode} := refl

def health-calls : evidence {sawHealthDo ≡ do-decide : Do} := refl

def health-one : evidence {sawHealthOne ≡ flag-no : Flag} := refl

def health-ask : evidence {sawAsk ≡ mode-decide : Mode} := refl

def health-write : evidence {sawWrite ≡ mode-write : Mode} := refl

def health-writes : evidence {sawWriteDo ≡ do-write : Do} := refl

def health-progress : evidence {sawProgress ≡ mode-write : Mode} := refl

def health-progress-off : evidence {sawProgressFlag ≡ flag-yes : Flag} := refl

def health-idle : evidence {sawIdle ≡ mode-idle : Mode} := refl

def idle-tick : evidence {sawIdleTick ≡ mode-closed : Mode} := refl

def second-read : evidence {sawSecond ≡ mode-decide : Mode} := refl

def close-req : evidence {sawClose ≡ mode-closed : Mode} := refl

def http10-req : evidence {sawHttp10 ≡ mode-closed : Mode} := refl

def malformed : evidence {sawBad ≡ mode-write : Mode} := refl

def malformed-done : evidence {sawBadDone ≡ mode-closed : Mode} := refl

def write-error : evidence {sawWerr ≡ mode-closed : Mode} := refl

def half-eof : evidence {sawHalf ≡ mode-half : Mode} := refl

def half-write : evidence {sawHalfWrite ≡ mode-half : Mode} := refl

def half-done : evidence {sawHalfDone ≡ mode-closed : Mode} := refl

def fin-with-request : evidence {sawFinReq ≡ mode-half : Mode} := refl

def fin-truncated : evidence {sawTrunc ≡ mode-half : Mode} := refl

def pipe-more : evidence {sawPipe ≡ flag-yes : Flag} := refl

def pipe-decide : evidence {sawPipeMode ≡ mode-decide : Mode} := refl

def after-close : evidence {step shut (evBytes healthReq) ≡ shut : Conn} := refl

def after-close-tick : evidence {step shut evTick ≡ shut : Conn} := refl

def after-close-do : evidence {sawAfterDo ≡ do-close : Do} := refl

def after-close-tick-do : evidence {sawAfterTick ≡ do-close : Do} := refl

def after-close-mode : evidence {sawAfterMode ≡ mode-closed : Mode} := refl
