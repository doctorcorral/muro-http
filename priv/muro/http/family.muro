-- Replies across connections in the poll loop.
--
-- One key is one connection. `accept` opens on arrival. It is never
-- held. `reply` stays held while any earlier instance of the same
-- connection is unresolved. An earlier accept counts, and so does an
-- earlier reply. An instance that has not arrived does not. Another
-- connection does not. An older reply that arrives after a newer one
-- has opened runs beside it. This is not one reply at a time.
-- `earlier_resolved` names the earlier replies known when this reply
-- opened. It does not count the reply that is opening, and it does
-- not count an accept.
--
-- The meeting is one reply: the peer puts `ok`, the host takes it,
-- and both end. It is not `session conn`. It does not classify, and
-- it does not choose a status. `--backend c` omits a family, so
-- `c/host.c` is not this dispatcher. The host still admits one
-- socket at a time through `admitChoice` and `muro__sess_conn_step`.
--
-- `mix muro.check` walks one fixed script. Key `a` is accept, then
-- reply, then reply. Key `b` is accept. The counts on the temporal
-- lines are that walk. They are not a proof for every connection
-- count. The pin proves the hold rule for any number of keys and
-- any number of instances, in that package's `agda/Muro/Family.agda`.
-- This book does not contain that proof. The program that writes
-- the dispatcher is not proved.
--
-- Not stated here. This pin has no formula for them:
--   `nconn` never exceeds `max_conn`
--   an accepted connection is eventually closed
--   a resolved connection never arrives another reply
-- The host keeps a slot until `close_slot`. The hold rule does not
-- make the host resolve. A later `reply` of a key can still open.

data Act : Type where
  accept : Act
  reply : Act

data Report : Type where
  ok : Report

session reply-out := send Report end
session reply-in := recv Report end

conform peer : reply-out := put ok done

conform host : reply-in :=
  get (r : Report) done

meet turn : host with peer buffer 1

family conns : turn per key of Act
  accept never held
  reply held while earlier unresolved

temporal drained : turn :=
  always ((host done) implies (inbox host is empty))

temporal reply-order : conns :=
  forall (k : key). always ((opened k reply) implies (earlier_resolved k reply))

temporal accept-free : conns :=
  forall (k : key). always (not (held k accept))

temporal reply-opens : conns :=
  forall (k : key). (held k reply) leads_to (opened k reply)
