-- A span after a 413 close. The step is quiet: span 0.
-- Not in muro.exs. mix muro.check --fuel 5000000 refuses it.
-- test/conn_test.exs gates that refusal.
import "../step.muro"

def span-after-close : evidence {spanOf (step0 (take (step0 readSt factBytes tooBig max10 (toU64 0) (toU64 0))) factPeer tooBig max10 (toU64 0) (toU64 0)) ≡ toU64 1 : U64} := refl
