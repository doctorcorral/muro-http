-- A second send after the error reply. The protocol is end.
-- Checked by test/conn_test.exs. Not part of the manifest.
import "../session.muro"

conform bad-write : conn :=
  rec Loop.
    pick0 (cover
      (get (p : Piece) (match p
        Loop
        (put reply-ok (pick0 Loop))
        (put reply-bad (put reply-bad done))))
      (cover
        (get (p : Piece) (match p
          (put reply-bad done)
          (put reply-ok done)
          (put reply-bad done)))
        done))
